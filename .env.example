# Local admin credentials
# TILLER_ADMIN_USERNAME / TILLER_ADMIN_PASSWORD are the deprecated names for
# these two; they are still accepted with a startup warning. The names above win
# if both are set.
TILLER_USERNAME=admin
TILLER_PASSWORD=replace-with-a-long-random-password

# Runtime user and group IDs
TILLER_RUN_UID=65532
TILLER_RUN_GID=65532

# Build-time file owner user and group IDs
TILLER_UID=65532
TILLER_GID=65532

# Host port
TILLER_PORT=8080

# Trusted reverse-proxy IP or CIDR. Required when TILLER_MODE=hosted.
# TILLER_TRUSTED_PROXY=172.16.0.0/12

# Admin session lifetime
# TILLER_USER_SESSION_TTL=720h

# Secure admin cookie setting
# TILLER_ADMIN_COOKIE_SECURE=false

# Models.dev metadata fallback
# TILLER_MODELS_DEV_ENABLED=true

# Admin-only memory and pprof debug endpoints
# TILLER_DEBUG_PPROF=false

# Authentication cache lifetimes
# TILLER_CLIENT_KEY_CACHE_TTL=15m
# TILLER_SESSION_CACHE_TTL=5m

# Mail provider and sender
# TILLER_MAIL_PROVIDER=smtp
# TILLER_MAIL_FROM=Tiller <no-reply@example.com>

# SMTP connection
# TILLER_MAIL_SMTP_HOST=smtp.example.com
# TILLER_MAIL_SMTP_PORT=587
# TILLER_MAIL_SMTP_MODE=starttls

# SMTP credentials
# TILLER_MAIL_SMTP_USERNAME=
# TILLER_MAIL_SMTP_PASSWORD=

# Master encryption key
# TILLER_MASTER_KEY=base64:replace-with-base64-of-32-random-bytes
# TILLER_MASTER_KEY_FILE=/run/secrets/tiller_master_key


# ---------------------------------------------------------------------------
# Hosted mode
# ---------------------------------------------------------------------------

# Deployment mode and public HTTPS origin
# TILLER_MODE=hosted
# TILLER_PUBLIC_URL=https://app.example.com

# Hosted platform admin credentials
# TILLER_PLATFORM_ADMIN_USERNAME=platform-admin
# TILLER_PLATFORM_ADMIN_PASSWORD=replace-with-a-secret
